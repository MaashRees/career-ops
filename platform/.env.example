# ─────────────────────────────────────────────────────────────
#  Chasseur d'emploi — configuration (variables d'environnement)
#  Copie ce fichier en .env (local / Docker) ou saisis ces valeurs
#  dans l'interface de ton hébergeur. NE COMMITE JAMAIS le vrai .env.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ──
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique "publishable" (ou "anon" sur un ancien projet). Soumise à la RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé SECRÈTE "service_role" / "secret". Serveur uniquement. Ne jamais la partager.
SUPABASE_SERVICE_ROLE_KEY=

# Schéma Postgres de l'application (créé par le script 0003). Ne change cette valeur que si tu as renommé le schéma.
# Il doit être ajouté dans Supabase → Project Settings → API → « Exposed schemas ».
SUPABASE_DB_SCHEMA=jobhunter

# ── URL publique de l'app (https, sans slash final) ──
# Doit être identique au "Site URL" réglé dans Supabase → Authentication → URL Configuration.
SITE_URL=https://jobs.exemple.com

# ── Clés IA : au moins une des deux ──
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Fournisseur principal quand les deux clés existent (anthropic | openrouter). Défaut : anthropic.
# LLM_PROVIDER=anthropic
# Si le principal est en panne / saturé / à court de crédit, bascule sur l'autre (défaut : oui). "off" pour désactiver.
# LLM_FALLBACK=on

# Modèles par niveau (défauts ci-dessous ; à surcharger si besoin)
# ANTHROPIC_MODEL_ECONOMY=claude-haiku-5-5
# ANTHROPIC_MODEL_STANDARD=claude-sonnet-5-5
# ANTHROPIC_MODEL_PREMIUM=claude-opus-5-5
# OPENROUTER_MODEL_ECONOMY=anthropic/claude-haiku-5.5
# OPENROUTER_MODEL_STANDARD=anthropic/claude-sonnet-5.5
# OPENROUTER_MODEL_PREMIUM=anthropic/claude-opus-5.5
# Vie privée OpenRouter : "deny" (défaut) n'envoie ton CV qu'à des fournisseurs qui ne conservent
# pas les prompts. Mettre "allow" seulement si une erreur « no endpoints » apparaît.
# OPENROUTER_DATA_COLLECTION=deny

# ── Accès et garde-fous de coût ──
# Administrateurs (page /admin : usage et coûts). Séparés par des virgules.
ADMIN_EMAILS=toi@exemple.com
# OBLIGATOIRE en production (le serveur refuse de démarrer sans) : seules ces adresses peuvent
# utiliser l'app, même si quelqu'un parvenait à créer un compte Supabase.
ALLOWED_EMAILS=toi@exemple.com,cousine@exemple.com,frere@exemple.com
# (déconseillé) autoriser tout compte Supabase : ALLOW_ANY_SUPABASE_USER=1
# Analyses IA par personne et par 24 h glissantes (0 = illimité). L'admin n'est pas concerné.
DAILY_RUN_LIMIT=20
# Plafond global par 24 h, tous utilisateurs confondus (0 = illimité). Protège ta facture.
GLOBAL_DAILY_RUN_LIMIT=150
# Analyses simultanées par personne.
MAX_CONCURRENT_RUNS=2
# Niveau de modèle maximum que chacun peut choisir : economy | standard | premium.
MAX_TIER=standard
